#!/bin/bash
PYTHONPATH="$(dirname "$0")"
export PYTHONPATH

SERVICE="$1"
shift

case $SERVICE in
  "run")
    echo "Starting development server..."
    uvicorn bin.server:app
    ;;

  "dev")
    echo "Starting dev server..."
    python3 bin/dev.py
    ;;

  "robot")
    echo "Creating robot.txt and sitemap.xml"
    python3 bin/robot.py
    ;;

  "test")
    echo "Running tests..."
    python3 lib/loadsite.py
    ;;
  *)
    echo "Usage: $0 {dev}"
    exit 1
    ;;
esac
