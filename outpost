#!/bin/bash
PYTHONPATH="$(dirname "$0")"
export PYTHONPATH

SERVICE="$1"
shift

case $SERVICE in
  "run")
    echo "Starting production server..."
    python3 bin/run.py
    ;;

  "dev")
    echo "Starting development server..."
    python3 bin/dev.py
    ;;

  "robot")
    echo "Creating robot.txt and sitemap.xml"
    python3 bin/robot.py
    ;;

  "test")
    echo "Running tests..."
    python3 lib/git.py init
    ;;
  *)
    echo "Usage: $0 {dev}"
    exit 1
    ;;
esac
